<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VMAFLite.ViewModels"
        x:Class="VMAFLite.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="400" Height="530"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        DragDrop.AllowDrop="True"
        PointerPressed="OnPointerPressed">
            
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.BrowseBtn">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="FloralWhite"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.BrowseBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4E4E52"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PrimaryBtn">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="FloralWhite"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.PrimaryBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#008BE6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PrimaryBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Padding="25">
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VMAFLite" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
                        <TextBlock Text="Perceptual Video Quality Assessment" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                         <Button Content="?" Command="{Binding ToggleAboutCommand}" Width="25" Height="25" 
                                 Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="#3E3E42" Foreground="White" CornerRadius="15"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#262626" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Reference Video (Original)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding ReferenceName}" Foreground="FloralWhite" TextTrimming="CharacterEllipsis" FontSize="14" Margin="0,0,15,0"/>
                            </StackPanel>
                            <Button Classes="BrowseBtn" Grid.Column="1" Content="Browse" Command="{Binding SelectReferenceFileCommand}" IsEnabled="{Binding !IsRunning}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Distorted Video (Compressed)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding DistortedName}" Foreground="FloralWhite" TextTrimming="CharacterEllipsis" FontSize="14" Margin="0,0,15,0"/>
                            </StackPanel>
                            <Button Classes="BrowseBtn" Grid.Column="1" Content="Browse" Command="{Binding SelectDistortedFileCommand}" IsEnabled="{Binding IsDistortedBrowseEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="4">
                    <TextBlock Text="Model Selection:" Foreground="LightGray" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton Content="HD/SD" FontSize="14" Foreground="FloralWhite" IsChecked="{Binding IsStandardModel}" IsEnabled="{Binding !IsRunning}"/>
                        <RadioButton Content="4K" FontSize="14" Foreground="FloralWhite" IsChecked="{Binding Is4kModel}" IsEnabled="{Binding !IsRunning}"/>
                    </StackPanel>
                    
                    <Separator Background="#3E3E42" Height="1" Margin="0,8,0,8"/>
                    
                    <Grid Margin="0,5,0,0" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, 165, Auto, *">
                        <Border Grid.Row="0" Grid.Column="0" Width="6" Height="18" Background="{Binding OverallColor}" CornerRadius="2" Margin="0,0,10,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="OVERALL RESULT:" Foreground="{Binding ResultTextColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding OverallScore}" Foreground="{Binding ResultTextColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <Border Grid.Row="1" Grid.Column="0" Width="6" Height="18" Background="{Binding StableMinColor}" CornerRadius="2" Margin="0,0,10,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="STABLE MINIMUM:" Foreground="{Binding ResultTextColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StableMinScore}" Foreground="{Binding ResultTextColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <Border Grid.Row="2" Grid.Column="0" Width="6" Height="18" Background="{Binding LowestMinColor}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WORST FRAME:" Foreground="Gray" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WorstFrameScore}" Foreground="Gray" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        
                        <Button Classes="BrowseBtn" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Content="COPY RESULTS" Command="{Binding CopyResultsCommand}" 
                                IsVisible="{Binding IsResultsAvailable}" IsEnabled="{Binding IsCopyEnabled}" 
                                VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10" Padding="8,4" CornerRadius="4"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="8" Margin="0,0,0,15">
                    <Separator Background="#3E3E42" Height="1" Margin="0,15,0,10"/>
                    <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Foreground="LightGray" FontSize="12"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="22" ShowProgressText="True" Foreground="#007ACC"/>
                </StackPanel>

                <Grid Grid.Row="4" ColumnDefinitions="*, *" Margin="0,0,0,0">
                    <Button Classes="PrimaryBtn" Grid.Column="1" Content="START" Command="{Binding RunAnalysisCommand}" IsEnabled="{Binding CanStart}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                    <Button Classes="PrimaryBtn" Grid.Column="0" Content="CANCEL" Command="{Binding CancelAnalysisCommand}" IsVisible="{Binding IsRunning}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                </Grid>
            </Grid>
        </Border>

        <Grid IsVisible="{Binding IsAboutVisible}" Background="#CC121212" PointerPressed="OnCloseAbout">
            <Border Background="#252526" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="8" Width="380" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="VMAFLite" FontWeight="Bold" FontSize="20" Foreground="FloralWhite" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Foreground="FloralWhite" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="Author: Rustam Shukurov" Foreground="FloralWhite" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    </StackPanel>
                    
                    <Separator Background="#3E3E42" Height="1" Margin="0,0,0,5"/>
                    <TextBlock Text="Understanding the Metrics" FontWeight="SemiBold" Foreground="FloralWhite" FontSize="13"/>
                    
                    <Grid ColumnDefinitions="110, *" RowDefinitions="Auto, Auto, Auto" Margin="0,0,0,5">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OVERALL RESULT:" Foreground="LightGray" FontSize="11" VerticalAlignment="Top" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Harmonic Mean. The average perceptual quality across the whole video." TextWrapping="Wrap" FontSize="11" Foreground="LightGray" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="STABLE MINIMUM:" Foreground="LightGray" FontSize="11" VerticalAlignment="Top" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="5th Percentile. The lowest quality expected for 95% of the viewing duration." TextWrapping="Wrap" FontSize="11" Foreground="LightGray" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="WORST FRAME:" Foreground="LightGray" FontSize="11" VerticalAlignment="Top" Margin="0,0,5,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="The single lowest score recorded. Useful for spotting glitches." TextWrapping="Wrap" FontSize="11" Foreground="LightGray"/>
                    </Grid>

                    <TextBlock Text="Quality Thresholds" FontWeight="SemiBold" Foreground="FloralWhite" FontSize="13" Margin="0,5,0,0"/>
                    
                    <Grid ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,0,0,5">
                        <Border Grid.Row="0" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#00C853" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="95 - 100" Foreground="LightGray" FontSize="11" Width="50"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Pristine (Indistinguishable)" Foreground="LightGray" FontSize="11"/>

                        <Border Grid.Row="1" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#C6FF00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="93 - 95" Foreground="LightGray" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Excellent (Netflix Standard)" Foreground="LightGray" FontSize="11"/>

                        <Border Grid.Row="2" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#FFAB00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="85 - 93" Foreground="LightGray" FontSize="11"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Good (Streaming/Web)" Foreground="LightGray" FontSize="11"/>

                        <Border Grid.Row="3" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#D50000" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="&lt; 85" Foreground="LightGray" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Poor (Visible Artifacts)" Foreground="LightGray" FontSize="11"/>
                    </Grid>

                    <Separator Background="#3E3E42" Height="1" Margin="0,5"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Engine &amp; Models" FontWeight="SemiBold" Foreground="FloralWhite" FontSize="12"/>
                        <TextBlock Text="Powered by FFmpeg &amp; libvmaf" FontSize="11" Foreground="LightGray"/>
                        <TextBlock Text="HD/SD Model: vmaf_v0.6.1neg" FontSize="11" Foreground="LightGray"/>
                        <TextBlock Text="4K Model: vmaf_4k_v0.6.1neg" FontSize="11" Foreground="LightGray"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>